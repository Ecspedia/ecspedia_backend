

type Query {
    #User Queries
    getUserById(id: ID!): User
    getAllUsers: [User!]!
    me:User
    #Chat1
    sendMessage(message:String!):ChatResponseDto!

    #Hotel Queries
    hotelsByLocation(location: String!): [HotelResponseDto!]!
    popularHotels: [HotelResponseDto!]!
    hotels: [HotelResponseDto!]!
    hotelById(id: ID!): HotelResponseDto

    hotelExists(id: ID!): Boolean!


    semanticSearchHotel(query:String!):String!
    askHotelQuestion(searchQuery:String!,hotelId:String!):[HotelResponseDto!]!

    #Booking Queries
    bookings: [Booking!]!
    bookingsByUserEmail(email: String!): [Booking!]!

    #Location Queries
    locations: [Location!]!
    topLocations: [Location!]!




}



type Mutation {
    registerUser(userRegistrationDto: UserRegistrationInput!): User!

    login(authRequest: AuthInput!): AuthResponse!
    forgotPassword(email: String!): PasswordResetResponse!
    resetPassword(email: String!, token: String!, newPassword: String!): PasswordResetResponse!
    logout: Boolean!

    createLocation(locationCreateDto: LocationCreateInput!): Location!
    createHotel(hotelCreateDto: HotelCreateInput!): HotelResponseDto!
    createBooking(bookingCreateDto: BookingCreateInput!): Booking!

    deleteBookingById(bookingId: ID!): String!

}


type User {
    id: ID!
    username: String!
    email: String!
}

input UserRegistrationInput {
    username: String!
    email: String!
    password: String!
}

input AuthInput {
    username: String!  # Can be either username or email
    password: String!
}

type AuthResponse {
    token: String!
}

type UserRegistrationResponse {
    message: String!
    user: User
}

type PasswordResetResponse {
    success: Boolean!
    message: String!
}


enum ChatResponseType {
    SEARCH_RESULTS
    QUESTION_ANSWER
    BOOKING
    OTHER
    ERROR
}
type ChatResponseDto {
    success: Boolean!
    chatResponseType: ChatResponseType!
    searchData:[HotelResponseDto!]
    questionData: String
    otherData: String
    bookingData: String
    errorData:String
}





type HotelResponseDto {
    id:ID!
    name:String!
    location:String!
    image:String
    isAvailable:Boolean!
    rating:Float
    reviewCount:Int
    pricePerNight:Float!
    latitude:Float
    longitude:Float
    hotelDescription:String
    hotelTypeId:Int
    chain:String
    currency:String
    country:String
    city:String
    address:String
    zip:String
    mainPhoto:String
    thumbnail:String
    stars:Int
    facilityIds:[Int!]
    accessibilityAttributes:HotelAccessibilityAttributes
    deletedAt:String
}

type HotelAccessibilityAttributes {
    attributes: [String!]
    showerChair: Boolean
    entranceType: String
    petFriendly: String
    rampAngle: Int
    rampLength: Int
    entranceDoorWidth: Int
    roomMaxGuestsNumber: Int
    distanceFromTheElevatorToTheAccessibleRoom: Int
}

input HotelCreateInput {
    id: ID
    name: String!
    location: String!
    image: String
    isAvailable: Boolean
    rating: Float
    reviewCount: Int
    pricePerNight: Float!
    latitude: Float
    longitude: Float
    hotelDescription: String
    hotelTypeId: Int
    chain: String
    currency: String
    country: String
    city: String
    address: String
    zip: String
    mainPhoto: String
    thumbnail: String
    stars: Int
    facilityIds: [Int!]
    accessibilityAttributes: HotelAccessibilityAttributesInput
    deletedAt: String
}

input HotelAccessibilityAttributesInput {
    attributes: [String!]
    showerChair: Boolean
    entranceType: String
    petFriendly: String
    rampAngle: Int
    rampLength: Int
    entranceDoorWidth: Int
    roomMaxGuestsNumber: Int
    distanceFromTheElevatorToTheAccessibleRoom: Int
}

type Location {
    id: ID!
    code: String!
    city: String!
    country: String!
    state: String
    latitude: Float
    longitude: Float
    isPopular: Boolean
}

input LocationCreateInput {
    code: String!
    city: String!
    country: String!
    state: String
    latitude: Float
    longitude: Float
}

input BookingCreateInput {
    hotelId: ID!
    userId: ID!
    firstNameGuest: String!
    lastNameGuest: String!
    emailGuest: String!
    phoneNumberGuest: String
    startTimeIso: String!
    endTimeIso: String!
    price: Int
    currency: String
}

type ImageUpdateResponse {
    imageId: ID!
    imageUrl: String!
    message: String!
}

type Booking {
    id: ID!
    hotelId: ID!
    userId: ID!
    firstNameGuest: String!
    lastNameGuest: String!
    emailGuest: String!
    phoneNumberGuest: String
    startTime: String!
    endTime: String!
    status: BookingStatus!
    price: Float
    currency: String
    createdAt: String!
    confirmedAt: String
    canceledAt: String
}

enum BookingStatus {
    PENDING
    CONFIRMED
    CANCELED
}
